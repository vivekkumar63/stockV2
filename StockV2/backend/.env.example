# ── Backend .env — copy to .env and fill in ──────────────────────────────────

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Security ──────────────────────────────────────────────────────────────────
API_KEY=change-me-use-a-long-random-string

# ── CORS (comma-free JSON list) ───────────────────────────────────────────────
# Add every origin that will load the frontend in a browser.
CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# ── Trading Config ────────────────────────────────────────────────────────────
TRADING_MODE=paper
TOTAL_CAPITAL=500000
PAPER_CAPITAL=500000
RISK_PER_TRADE_PCT=2.0
MAX_OPEN_POSITIONS=8
MAX_SINGLE_STOCK_PCT=20.0
MAX_SECTOR_PCT=35.0
DAILY_LOSS_LIMIT_PCT=3.0
AUTO_TRADING_ENABLED=false

# ── Signal Config ─────────────────────────────────────────────────────────────
MIN_CONFIDENCE_FOR_ALERT=0.65
MAX_AI_SIGNALS_PER_DAY=10

# ── Dev / Testing ─────────────────────────────────────────────────────────────
# Set to a positive integer to cap the number of symbols processed during
# precompute — useful for fast local testing. 0 (default) = all symbols.
# DEV_SYMBOL_LIMIT=20

# ── Database ──────────────────────────────────────────────────────────────────
# Windows (native PostgreSQL): postgresql://stockv2:stockv2@localhost:5432/stockv2
# Ubuntu  (Docker):            postgresql://stockv2:stockv2@localhost:5432/stockv2
DATABASE_URL=postgresql://stockv2:stockv2@localhost:5432/stockv2

# ── App ───────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
