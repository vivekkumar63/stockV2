# ── Frontend .env — copy to .env and fill in ─────────────────────────────────

# API base URL.
#   Local dev:          http://localhost:8000/api/v1
#   Docker / nginx:     /api/v1    (nginx proxies, no host needed)
#   Remote VM (direct): http://<vm-ip>:8000/api/v1
VITE_API_BASE=http://localhost:8000/api/v1

# Must match API_KEY in backend .env
VITE_API_KEY=change-me-use-a-long-random-string
