# ── StockV2 — root .env for Docker deployment ────────────────────────────────
# Copy to .env and fill in your values before running docker-compose up

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Security ──────────────────────────────────────────────────────────────────
# Change this! Used by the frontend and all API calls.
API_KEY=change-me-use-a-long-random-string

# ── CORS origins ─────────────────────────────────────────────────────────────
# Add your VM's IP or domain so the browser can reach the API.
# When using nginx reverse proxy (docker-compose default), both frontend and
# backend share the same origin, so CORS is not needed — keep the default.
# For direct backend access from a different host, add it here:
#   CORS_ORIGINS=["http://localhost","http://your-vm-ip","https://your-domain.com"]
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# ── Trading Config ────────────────────────────────────────────────────────────
TRADING_MODE=paper
TOTAL_CAPITAL=500000
PAPER_CAPITAL=500000
RISK_PER_TRADE_PCT=2.0
MAX_OPEN_POSITIONS=8
AUTO_TRADING_ENABLED=false

# ── App ───────────────────────────────────────────────────────────────────────
# HOST/PORT are only used in bare-metal mode (docker uses its own networking)
HOST=0.0.0.0
PORT=8000
DB_PATH=data/stockv2.db
